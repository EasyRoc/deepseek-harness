# Moldex Agent macOS packaging: copy to .env.macos (gitignored) and fill signing fields.
# See .env.macos.example for Apple notarization options and field semantics.

DSH_DESKTOP_APP_ID=top.moldex.agent
DSH_DESKTOP_CLIENT_BUILD_PROFILE=moldex
DSH_DESKTOP_PRODUCT_NAME=Moldex Agent
DSH_DESKTOP_ARTIFACT_BASENAME=moldex-agent
DSH_DESKTOP_MAC_ICON=resources/icon-macos-moldex.png

DSH_DESKTOP_AUTO_UPDATE_ENV=test
DOWNLOAD_TEST_ORIGIN=
DOWNLOAD_TEST_RELEASE_ID=

DSH_DESKTOP_MANDATORY_UPDATE_TEST_ORIGIN=
DSH_DESKTOP_MANDATORY_UPDATE_PROD_ORIGIN=
DSH_DESKTOP_MANDATORY_UPDATE_CONFIG='{"allowedAuthOrigins":["https://www.moldex.top"]}'

DSH_DESKTOP_MACOS_PACK_CONCURRENCY=4
DSH_DESKTOP_MACOS_DOWNLOAD_PROXY=
DSH_DESKTOP_MACOS_NOTARIZATION_PROXY=

DSH_DESKTOP_MACOS_SIGNING_IDENTITY=
DSH_DESKTOP_MACOS_TEAM_ID=

CSC_LINK=
CSC_KEY_PASSWORD=

# Notarization: configure exactly one strategy from .env.macos.example.
